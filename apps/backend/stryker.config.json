{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner_comment": "Mutation testing del paquete de dominio (criterio del eje B: mutation score >= 60 %). Correr con: pnpm back test:mutacion. Reporte HTML en reports/mutation/mutation.html.",
  "packageManager": "pnpm",
  "testRunner": "tap",
  "plugins": [
    "@stryker-mutator/tap-runner"
  ],
  "tap": {
    "testFiles": [
      "src/**/*.spec.ts"
    ],
    "nodeArgs": [
      "--require",
      "ts-node/register/transpile-only",
      "-r",
      "{{hookFile}}",
      "{{testFile}}"
    ],
    "forceBail": true
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/modules/expensas/prorrateo.ts",
    "src/modules/expensas/estado-liquidacion.ts",
    "src/modules/expensas/estado-boleta.ts",
    "src/modules/expensas/cobranzas.ts",
    "src/modules/asambleas/quorum.ts",
    "src/modules/votaciones/escrutinio.ts",
    "src/modules/votaciones/padron.ts",
    "src/modules/reservas/horario.ts",
    "src/modules/auth/alcance.ts",
    "src/modules/auth/limitador-login.ts",
    "src/modules/auth/jwt.opciones.ts",
    "src/modules/pagos/recibo.ts",
    "src/modules/panel/indicadores.ts",
    "src/modules/usuarios/preferencias.ts",
    "src/modules/novedades/muro.ts",
    "src/modules/bandeja/bandeja.ts",
    "src/modules/archivos/tipos-archivo.ts"
  ],
  "ignorePatterns": [
    "acceptance/resultados",
    "coverage",
    "dist",
    "reports"
  ],
  "concurrency": 4,
  "timeoutMS": 20000,
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  }
}
