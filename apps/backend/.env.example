# Server
PORT=4000
API_GLOBAL_PREFIX=/api
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=admin_consorcios

# Solo para desarrollo: sincroniza el esquema con las entidades al levantar.
# En producción SIEMPRE false — el esquema se mueve con migraciones.
DB_SYNC=true
