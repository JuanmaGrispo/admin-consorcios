# Server
PORT=4000
API_GLOBAL_PREFIX=/api
CORS_ORIGINS=http://localhost:3000

# ── Base de datos ─────────────────────────────────────────────────────────────
# Opción A (la que usamos): Supabase. Connection string completa.
#
#   Supabase → Project Settings → Database → Connection string → URI
#
# Usar el "Session pooler" (puerto 5432). El "Transaction pooler" (6543) no
# banca prepared statements ni DDL con estado, así que rompe las migraciones.
# Reemplazar [YOUR-PASSWORD] por la password de la base (NO la del login de
# Supabase). Si tiene caracteres raros, url-encodearla.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Opción B: Postgres local. Comentar DATABASE_URL y descomentar esto.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=admin_consorcios

# SSL. Si no se define: on cuando hay DATABASE_URL, off cuando es local.
# Supabase lo exige, así que con DATABASE_URL no hace falta tocarlo.
# DB_SSL=true

# NOTA: no hay DB_SYNC. El esquema lo manda la base y las entidades se
# generan desde ahi con `pnpm back db:generate-entities`, asi que TypeORM
# nunca escribe DDL. Ver la seccion "Base de datos" del README.

# ── Autenticacion ─────────────────────────────────────────────────────────────
# Secreto con el que se firman los JWT. Generar uno propio por entorno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Si se cambia, todas las sesiones abiertas dejan de valer.
JWT_SECRET=cambiame-por-un-secreto-generado
JWT_EXPIRES_IN=1d

# ── Mercado Pago ──────────────────────────────────────────────────────────────
# Credenciales de PRUEBA para desarrollo: Mercado Pago Developers → Tus
# integraciones → Credenciales de prueba. Sin estas variables, el cobro online
# responde 503 y el resto de la app anda igual.
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Tus integraciones → Webhooks). Firma los avisos.
MP_WEBHOOK_SECRET=
# URL pública a la que MP manda los avisos. En local, un túnel (ngrok, etc.):
#   https://<tunel>/api/pagos/webhook/mercadopago
MP_NOTIFICATION_URL=
# A dónde vuelve el vecino después de pagar.
FRONTEND_URL=http://localhost:3000

# ── Archivos (Supabase Storage) ───────────────────────────────────────────────
# Dónde se guardan las fotos de reclamos, los comprobantes de gastos, los
# adjuntos de novedades y votaciones, las actas y los avatares. Sin estas
# variables, POST /archivos responde 503 y el resto de la app anda igual.
#
# SUPABASE_URL: Project Settings → API → Project URL.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Project Settings → API → service_role. Es una clave de servidor: NUNCA va al
# frontend ni a un repo. Saltea las policies de RLS.
SUPABASE_SERVICE_ROLE_KEY=
# El bucket, que hay que crear a mano en Storage y marcar como público.
SUPABASE_STORAGE_BUCKET=domus
